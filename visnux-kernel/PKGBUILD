pkgbase=visnux-kernel
pkgname=('visnux-kernel' 'visnux-kernel-headers')
pkgver=7.2.15
pkgrel=1
arch=('x86_64')
url="https://visnux.org"
license=('GPL2')
depends=('coreutils' 'kmod' 'initramfs')
makedepends=('bc' 'cpio' 'gettext' 'libelf' 'pahole' 'perl' 'tar' 'xz')
options=('!strip')
_kver="${pkgver}visnux"

source=("https://www.kernel.org/pub/linux/kernel/v7.x/linux-${pkgver}.tar.xz" "config")
sha256sums=('d0f6b1d7324c937ccaeb5c4ca7084bfcf71db2edb3e2d3a31f0ad83a681809ab' 'e4af332828494f91fbd970ca739ca32a0ea93b0536ce3d10598bb81b8c61fd99')

build() {
  cd "linux-${pkgver}"
  cp "$srcdir/config" .config
  make olddefconfig
  make -j"$(nproc)" bzImage modules
}

package_visnux-kernel() {
  pkgdesc="Visnux Custom Linux Kernel for gaming and development"
  provides=("kernel=${pkgver}")

  cd "linux-${pkgver}"
  make INSTALL_MOD_PATH="$pkgdir/usr" modules_install
  rm -f "$pkgdir/usr/lib/modules/${_kver}/source" "$pkgdir/usr/lib/modules/${_kver}/build"

  install -d "$pkgdir/boot"
  install -m644 arch/x86/boot/bzImage "$pkgdir/boot/vmlinuz-${pkgver}-visnux"
}

package_visnux-kernel-headers() {
  pkgdesc="Header files and scripts for building modules for Visnux kernel"
  depends=('coreutils' 'kmod' 'initramfs')

  cd "linux-${pkgver}"
  local _builddir="$pkgdir/usr/lib/modules/${_kver}/build"

  install -dm755 "$_builddir"
  cp Makefile Module.symvers System.map .config "$_builddir"
  if [[ -f vmlinux.h ]]; then
    cp vmlinux.h "$_builddir"
  fi
  cp -r include arch scripts "$_builddir"
  find "$_builddir" -type f -name "*.o" -delete
}
